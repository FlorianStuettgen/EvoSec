{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlorianStuettgen/SOC_Replay/blob/main/schemas/benchmark-result.schema.json",
  "title": "SOC_Replay deterministic-workload benchmark result",
  "type": "object",
  "required": [
    "benchmark_schema_version",
    "engine",
    "benchmark_id",
    "scenario_id",
    "run_id",
    "plan_fingerprint",
    "source_event_count",
    "expanded_event_count",
    "workload_id",
    "config",
    "environment",
    "passed",
    "rules"
  ],
  "properties": {
    "benchmark_schema_version": {"const": "1.0"},
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "soc-replay"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "benchmark_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "plan_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_event_count": {"type": "integer", "minimum": 1},
    "expanded_event_count": {"type": "integer", "minimum": 1},
    "workload_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config": {
      "type": "object",
      "required": ["copies", "iterations", "warmups", "spacing_seconds"],
      "properties": {
        "copies": {"type": "integer", "minimum": 1},
        "iterations": {"type": "integer", "minimum": 1},
        "warmups": {"type": "integer", "minimum": 0},
        "spacing_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["python_implementation", "python_version", "platform", "machine", "processor", "executable"],
      "additionalProperties": {"type": "string"}
    },
    "passed": {"type": "boolean"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "rule_fingerprint",
          "indexed_strategy",
          "indexed_candidate_count",
          "full_scan_candidate_count",
          "candidate_reduction_ratio",
          "median_speedup",
          "timings",
          "semantic_proof"
        ],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "rule_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "indexed_strategy": {"type": "string", "minLength": 1},
          "indexed_candidate_count": {"type": "integer", "minimum": 0},
          "full_scan_candidate_count": {"type": "integer", "minimum": 0},
          "candidate_reduction_ratio": {"type": "number"},
          "median_speedup": {"type": "number", "minimum": 0},
          "timings": {
            "type": "object",
            "required": ["index_build", "indexed_evaluation", "full_scan_evaluation"],
            "properties": {
              "index_build": {"$ref": "#/$defs/timing"},
              "indexed_evaluation": {"$ref": "#/$defs/timing"},
              "full_scan_evaluation": {"$ref": "#/$defs/timing"}
            },
            "additionalProperties": false
          },
          "semantic_proof": {"$ref": "index-equivalence-proof.schema.json#/$defs/ruleProof"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "timing": {
      "type": "object",
      "required": ["minimum_ns", "median_ns", "maximum_ns"],
      "properties": {
        "minimum_ns": {"type": "integer", "minimum": 0},
        "median_ns": {"type": "integer", "minimum": 0},
        "maximum_ns": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
