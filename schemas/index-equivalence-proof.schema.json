{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlorianStuettgen/SOC_Replay/blob/main/schemas/index-equivalence-proof.schema.json",
  "title": "SOC_Replay indexed/full-scan equivalence proof",
  "type": "object",
  "required": [
    "proof_schema_version",
    "engine",
    "proof_id",
    "scenario_id",
    "run_id",
    "plan_fingerprint",
    "event_count",
    "indexed_candidate_count",
    "full_scan_candidate_count",
    "candidate_reduction",
    "passed",
    "rules"
  ],
  "properties": {
    "proof_schema_version": {"const": "1.0"},
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "soc-replay"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "proof_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "plan_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_count": {"type": "integer", "minimum": 1},
    "indexed_candidate_count": {"type": "integer", "minimum": 0},
    "full_scan_candidate_count": {"type": "integer", "minimum": 0},
    "candidate_reduction": {"type": "integer"},
    "passed": {"type": "boolean"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ruleProof"}
    }
  },
  "$defs": {
    "ruleProof": {
      "type": "object",
      "required": [
        "rule_id",
        "rule_fingerprint",
        "indexed_strategy",
        "indexed_candidate_count",
        "full_scan_candidate_count",
        "candidate_reduction",
        "candidate_reduction_ratio",
        "semantic_digest",
        "passed",
        "failures"
      ],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "rule_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "indexed_strategy": {"type": "string", "minLength": 1},
        "indexed_candidate_count": {"type": "integer", "minimum": 0},
        "full_scan_candidate_count": {"type": "integer", "minimum": 0},
        "candidate_reduction": {"type": "integer"},
        "candidate_reduction_ratio": {"type": "number"},
        "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "passed": {"type": "boolean"},
        "failures": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
