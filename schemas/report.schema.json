{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlorianStuettgen/SOC_Replay/blob/main/schemas/report.schema.json",
  "title": "SOC_Replay evidence report",
  "type": "object",
  "required": [
    "report_schema_version",
    "engine",
    "provenance",
    "execution",
    "scenario",
    "summary",
    "verification",
    "detections",
    "simulated_actions"
  ],
  "properties": {
    "report_schema_version": {
      "const": "2.1"
    },
    "engine": {
      "$ref": "#/$defs/engine"
    },
    "provenance": {
      "type": "object",
      "required": [
        "run_id",
        "scenario_sha256",
        "events_sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "scenario_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "events_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "plan",
        "rules",
        "ledger"
      ],
      "properties": {
        "plan": {
          "type": "object",
          "required": [
            "scenario_id",
            "fingerprint",
            "rules"
          ],
          "properties": {
            "scenario_id": {
              "type": "string",
              "minLength": 1
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/plan_rule"
              }
            }
          },
          "additionalProperties": false
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/trace"
          }
        },
        "ledger": {
          "$ref": "execution-ledger.schema.json"
        }
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "title",
        "objective",
        "authorization_boundary",
        "expected_outcome"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "1.0",
            "1.1"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "authorization_boundary": {
          "type": "string",
          "minLength": 1
        },
        "expected_outcome": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "events_processed",
        "rules_executed",
        "detections",
        "simulated_actions",
        "verification_passed"
      ],
      "properties": {
        "events_processed": {
          "type": "integer",
          "minimum": 1
        },
        "rules_executed": {
          "type": "integer",
          "minimum": 1
        },
        "detections": {
          "type": "integer",
          "minimum": 0
        },
        "simulated_actions": {
          "type": "integer",
          "minimum": 0
        },
        "verification_passed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "passed",
        "checks"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      },
      "additionalProperties": false
    },
    "detections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/detection"
      }
    },
    "simulated_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "engine": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "soc-replay"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "plan_rule": {
      "type": "object",
      "required": [
        "id",
        "fingerprint",
        "candidate_selectors"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_selectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "value",
              "mode"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "eq",
                  "contains"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "required": [
        "rule_id",
        "rule_fingerprint",
        "candidate_strategy",
        "candidate_count",
        "matched_count",
        "group_count",
        "windows_considered",
        "detection_count"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_strategy": {
          "type": "string",
          "minLength": 1
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "matched_count": {
          "type": "integer",
          "minimum": 0
        },
        "group_count": {
          "type": "integer",
          "minimum": 0
        },
        "windows_considered": {
          "type": "integer",
          "minimum": 0
        },
        "detection_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": [
        "name",
        "expected",
        "actual",
        "passed"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expected": {},
        "actual": {},
        "passed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "detection": {
      "type": "object",
      "required": [
        "detection_id",
        "rule_id",
        "rule_name",
        "rule_description",
        "severity",
        "first_seen",
        "last_seen",
        "event_ids",
        "group",
        "correlation",
        "response"
      ],
      "properties": {
        "detection_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_name": {
          "type": "string",
          "minLength": 1
        },
        "rule_description": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "informational",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "first_seen": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "group": {
          "type": "object"
        },
        "correlation": {
          "type": "object",
          "required": [
            "type",
            "event_count",
            "candidate_strategy",
            "candidate_events",
            "matched_events",
            "rule_fingerprint"
          ],
          "properties": {
            "type": {
              "enum": [
                "single_event",
                "time_window"
              ]
            },
            "event_count": {
              "type": "integer",
              "minimum": 1
            },
            "candidate_strategy": {
              "type": "string",
              "minLength": 1
            },
            "candidate_events": {
              "type": "integer",
              "minimum": 0
            },
            "matched_events": {
              "type": "integer",
              "minimum": 0
            },
            "rule_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "threshold": {
              "type": "integer",
              "minimum": 1
            },
            "within_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "window_policy": {
              "enum": [
                "first_per_group",
                "all_non_overlapping"
              ]
            },
            "distinct_field": {
              "type": [
                "string",
                "null"
              ]
            },
            "distinct_count": {
              "type": "integer",
              "minimum": 0
            },
            "distinct_threshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "required": [
            "action",
            "description",
            "mode"
          ],
          "properties": {
            "action": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "const": "simulated"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "detection_id",
        "action",
        "description",
        "mode"
      ],
      "properties": {
        "detection_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "simulated"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
